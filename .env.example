# SocialVerse – Beispielkonfiguration
# Kopiere diese Datei nach ".env" (start.bat erledigt das automatisch, ohne eine vorhandene .env zu überschreiben).
# Die Datei ".env" wird NICHT in Git gespeichert.

# Port des Backends (im Produktionsstart auch die Adresse der App: http://localhost:3001)
PORT=3001

# Netzwerkadresse. 127.0.0.1 = nur auf diesem Computer erreichbar (empfohlen).
HOST=127.0.0.1

# Ordner für die lokale SQLite-Datenbank
DATA_DIR=./data

# Optional: OpenRouter-API-Schlüssel (https://openrouter.ai/keys).
# Ohne Schlüssel läuft SocialVerse im lokalen Demo-Modus.
# Alternativ kann der Schlüssel in der App unter Einstellungen > KI & Modelle eingetragen werden.
# Ein hier gesetzter Schlüssel hat Vorrang.
OPENROUTER_API_KEY=

# Optional: abweichende OpenRouter-Adresse (normalerweise nicht ändern)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
