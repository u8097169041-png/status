# SocialVerse – Beispielkonfiguration
# Kopiere diese Datei nach ".env" (start.bat erledigt das automatisch, ohne eine vorhandene .env zu überschreiben).
# Die Datei ".env" wird NICHT in Git gespeichert. Ohne Änderungen startet SocialVerse sofort:
# mit lokaler KI, falls Ollama läuft – sonst mit der simulierten KI. Es entstehen keine Kosten.

# Port des Backends (im Produktionsstart auch die Adresse der App: http://localhost:3001)
PORT=3001

# Netzwerkadresse. 127.0.0.1 = nur auf diesem Computer erreichbar (empfohlen).
HOST=127.0.0.1

# Ordner für die lokale SQLite-Datenbank
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Lokale KI (Ollama) – kostenlos, Daten bleiben auf diesem Computer
# Einrichtung unter Windows: ki-einrichten.bat (fragt vor jedem Download nach). Prüfen: npm run ai:check
# ---------------------------------------------------------------------------
# true = lokale KI verwenden, sobald sie erreichbar ist; false = nie danach suchen
LOCAL_AI_ENABLED=true
# Adresse der Ollama-Laufzeit (Standard von Ollama)
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
# Festes Modell, z. B. gemma3:4b. Leer = in der App wählen bzw. automatisch das beste installierte Modell.
LOCAL_AI_MODEL=
# Zeitlimits der lokalen KI in Millisekunden. Antworten werden gestreamt: Solange die KI Text liefert, wird gewartet.
# Bis zum ersten Wort (enthält das Laden des Modells in den Speicher – auf langsamen Rechnern bis zu 1–2 Minuten)
LOCAL_AI_LOAD_TIMEOUT_MS=120000
# Höchstens so lange Pause zwischen zwei Wörtern, sonst gilt die Ausgabe als hängengeblieben
LOCAL_AI_IDLE_TIMEOUT_MS=30000
# Gesamtdauer einer Chat-Antwort
LOCAL_AI_TIMEOUT_MS=180000
# Gesamtdauer eines Weltentwurfs (läuft im Hintergrund, mit Fortschritt und Abbruch)
LOCAL_AI_LONG_TIMEOUT_MS=600000
# Obergrenze für die Länge einer Antwort (Tokens)
LOCAL_AI_MAX_TOKENS=350

# ---------------------------------------------------------------------------
# Server-KI (optional, für einen späteren zentralen Betrieb) – KANN KOSTEN VERURSACHEN
# Nur für den Betreiber: Spieler geben nie eigene Schlüssel ein. Die Server-KI wird nur genutzt, wenn
#   1. SERVER_AI_ENABLED=true gesetzt ist, Schlüssel und Modell vorhanden sind UND
#   2. der Nutzer sie in den Einstellungen ausdrücklich freigibt.
# Es gibt keine automatischen Wiederholungen. Bei Fehlern oder erreichten Limits antwortet die lokale bzw. simulierte KI.
# Im Hosting den Schlüssel im Secret Store des Anbieters hinterlegen, nicht in Dateien.
# ---------------------------------------------------------------------------
SERVER_AI_ENABLED=false
# OpenAI-kompatible Adresse (z. B. OpenRouter oder ein eigener Dienst)
SERVER_AI_BASE_URL=https://openrouter.ai/api/v1
SERVER_AI_API_KEY=
# Modell-ID beim Anbieter (Pflicht), optional ein eigenes Modell für Weltaktivität
SERVER_AI_MODEL=
SERVER_AI_WORLD_MODEL=
# Harte Obergrenzen (die Einstellungen in der App können nur niedriger sein)
SERVER_AI_TIMEOUT_MS=20000
SERVER_AI_MAX_TOKENS=400
# Für Weltentwürfe (längere Antworten)
SERVER_AI_LONG_TIMEOUT_MS=90000
SERVER_AI_MAX_TOKENS_LONG=2200
SERVER_AI_MAX_REQUESTS_PER_DAY=200
SERVER_AI_MAX_REQUESTS_PER_MINUTE=6
SERVER_AI_DAILY_BUDGET_USD=0.20
SERVER_AI_MONTHLY_BUDGET_USD=2
# Preise in USD pro 1 Mio. Tokens (Eingabe/Ausgabe). Leer = Preisliste des Dienstes abfragen (OpenRouter).
# Sind die Preise unbekannt, sendet SocialVerse keine Anfrage.
SERVER_AI_PRICE_INPUT_PER_MTOK=
SERVER_AI_PRICE_OUTPUT_PER_MTOK=

# Hinweis: OPENROUTER_API_KEY / OPENROUTER_BASE_URL aus älteren Versionen werden als SERVER_AI_API_KEY /
# SERVER_AI_BASE_URL übernommen, aktivieren die Server-KI aber nicht ohne SERVER_AI_ENABLED=true.
